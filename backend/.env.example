# Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/vinh_khanh_audio_guide

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_key_too
JWT_REFRESH_EXPIRES_IN=7d

# VNPAY (Sandbox)
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/v1/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:3000/api/v1/payments/vnpay/ipn

