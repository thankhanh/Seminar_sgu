// generator client
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  user
  merchant
  admin
}

enum MerchantStatus {
  pending
  approved
  rejected
  blocked
}

enum StoreStatus {
  pending
  active
  hidden
}

enum SubscriptionPlan {
  monthly
  yearly
}

enum MerchantPlan {
  starter
  business
  premium
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum TransactionType {
  user_subscription
  merchant_subscription
}

enum PaymentMethod {
  vnpay
  momo
  cash
}

enum TransactionStatus {
  pending
  success
  failed
  refunded
}

enum ListenSource {
  gps
  qr
}

// Models
model User {
  id                  String    @id @default(uuid())
  name                String    @db.VarChar(100)
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash")
  phone               String?   @db.VarChar(20)
  role                UserRole  @default(user)
  preferredLanguage   String    @default("vi") @map("preferred_language") @db.VarChar(10)
  avatarUrl           String?   @map("avatar_url")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  merchant            Merchant?
  subscriptions       Subscription[]
  transactions        Transaction[]
  listenHistory       ListenHistory[]

  @@map("users")
}

model Language {
  id          String    @id @default(uuid())
  code        String    @unique @db.VarChar(10)
  name        String    @db.VarChar(50)
  flagIcon    String?   @map("flag_icon")
  isActive    Boolean   @default(true) @map("is_active")

  narrations  Narration[]

  @@map("languages")
}

model Merchant {
  id            String          @id @default(uuid())
  userId        String          @unique @map("user_id")
  businessName  String          @map("business_name") @db.VarChar(200)
  taxCode       String?         @map("tax_code") @db.VarChar(50)
  status        MerchantStatus  @default(pending)
  rejectReason  String?         @map("reject_reason")
  createdAt     DateTime        @default(now()) @map("created_at")

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stores                Store[]
  merchantSubscriptions MerchantSubscription[]

  @@map("merchants")
}

model Store {
  id          String      @id @default(uuid())
  merchantId  String      @map("merchant_id")
  name        String      @db.VarChar(200)
  description String?
  address     String
  lat         Float
  lng         Float
  openTime    String?     @map("open_time") @db.VarChar(5)
  closeTime   String?     @map("close_time") @db.VarChar(5)
  coverImage  String?     @map("cover_image")
  status      StoreStatus @default(pending)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  merchant      Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  images        StoreImage[]
  menus         Menu[]
  narrations    Narration[]
  qrCodes       QrCode[]
  listenHistory ListenHistory[]

  @@map("stores")
}

model StoreImage {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  imageUrl    String    @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_images")
}

model Menu {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  name        String    @db.VarChar(200)
  description String?
  price       Decimal   @db.Decimal(12, 0)
  imageUrl    String?   @map("image_url")
  isAvailable Boolean   @default(true) @map("is_available")
  createdAt   DateTime  @default(now()) @map("created_at")

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("menus")
}

model Narration {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  languageId    String    @map("language_id")
  audioUrl      String?   @map("audio_url")
  textContent   String?   @map("text_content")
  duration      Int?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  language      Language    @relation(fields: [languageId], references: [id])
  listenHistory ListenHistory[]

  @@unique([storeId, languageId])
  @@map("narrations")
}

model ListenHistory {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  storeId       String        @map("store_id")
  narrationId   String        @map("narration_id")
  source        ListenSource  @default(gps)
  listenedAt    DateTime      @default(now()) @map("listened_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  narration     Narration     @relation(fields: [narrationId], references: [id], onDelete: Cascade)

  @@map("listen_history")
}

model Subscription {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  plan        SubscriptionPlan
  startDate   DateTime            @map("start_date") @db.Date
  endDate     DateTime            @map("end_date") @db.Date
  status      SubscriptionStatus  @default(active)
  createdAt   DateTime            @default(now()) @map("created_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model MerchantSubscription {
  id          String              @id @default(uuid())
  merchantId  String              @map("merchant_id")
  plan        MerchantPlan
  maxStore    Int                 @map("max_store")
  startDate   DateTime            @map("start_date") @db.Date
  endDate     DateTime            @map("end_date") @db.Date
  status      SubscriptionStatus  @default(active)
  createdAt   DateTime            @default(now()) @map("created_at")

  merchant    Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_subscriptions")
}

model Transaction {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  amount          Decimal             @db.Decimal(15, 0)
  currency        String              @default("VND") @db.VarChar(10)
  type            TransactionType
  paymentMethod   PaymentMethod       @map("payment_method")
  paymentRefId    String?             @map("payment_ref_id")
  status          TransactionStatus   @default(pending)
  description     String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  user            User                @relation(fields: [userId], references: [id])
  vnpayDetail     PaymentVnpay?
  momoDetail      PaymentMomo?

  @@map("transactions")
}

model PaymentVnpay {
  id                  String      @id @default(uuid())
  transactionId       String      @unique @map("transaction_id")
  vnpTxnRef           String      @unique @map("vnp_txn_ref") @db.VarChar(100)
  vnpAmount           BigInt      @map("vnp_amount")
  vnpOrderInfo        String?     @map("vnp_order_info")
  vnpTransactionNo    String?     @map("vnp_transaction_no") @db.VarChar(100)
  vnpBankCode         String?     @map("vnp_bank_code") @db.VarChar(50)
  vnpPayDate          String?     @map("vnp_pay_date") @db.VarChar(20)
  vnpResponseCode     String?     @map("vnp_response_code") @db.VarChar(10)
  vnpSecureHash       String?     @map("vnp_secure_hash")
  rawResponse         Json?       @map("raw_response")
  createdAt           DateTime    @default(now()) @map("created_at")

  transaction         Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("payment_vnpay")
}

model PaymentMomo {
  id              String      @id @default(uuid())
  transactionId   String      @unique @map("transaction_id")
  orderId         String      @unique @map("order_id") @db.VarChar(100)
  requestId       String?     @map("request_id") @db.VarChar(100)
  amount          BigInt
  orderInfo       String?     @map("order_info")
  momoTransId     String?     @map("momo_trans_id") @db.VarChar(100)
  resultCode      Int?        @map("result_code")
  message         String?
  payType         String?     @map("pay_type") @db.VarChar(50)
  signature       String?
  rawResponse     Json?       @map("raw_response")
  createdAt       DateTime    @default(now()) @map("created_at")

  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("payment_momo")
}

model QrCode {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  code        String    @unique @db.VarChar(100)
  qrImageUrl  String?   @map("qr_image_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("qr_codes")
}
